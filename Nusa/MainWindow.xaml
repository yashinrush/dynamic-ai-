<Window x:Class="Nusa.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nusa" Width="244" Height="48" MinWidth="244" MinHeight="48"
        WindowStyle="None" ResizeMode="NoResize" AllowsTransparency="True"
        Background="Transparent" Topmost="True" ShowInTaskbar="False"
        ShowActivated="False" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing"
        MouseEnter="Window_MouseEnter" MouseLeave="Window_MouseLeave">
    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#F20A0B0E" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#FF17181C" />
        <SolidColorBrush x:Key="MutedBrush" Color="#FF9699A2" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF78A9FF" />
        <SolidColorBrush x:Key="GreenBrush" Color="#FF49D69B" />
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF4F4F7" />
            <Setter Property="Background" Value="#FF20222C" />
            <Setter Property="BorderBrush" Value="#FF30323E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,7" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="16" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform><ScaleTransform x:Name="ButtonScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="b" Property="Background" Value="#FF303340"/><Setter TargetName="b" Property="BorderBrush" Value="#FF55596A"/>
                                <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1.035" Duration="0:0:0.13"/><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1.035" Duration="0:0:0.13"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                                <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"/><DoubleAnimation Storyboard.TargetName="ButtonScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.82"/></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.42"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TextBoxStyle" TargetType="TextBox">
            <Setter Property="Foreground" Value="#FFF4F4F7"/><Setter Property="Background" Value="#FF11131A"/>
            <Setter Property="BorderBrush" Value="#FF333641"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/><Setter Property="CaretBrush" Value="White"/>
        </Style>
        <Style x:Key="CheckBoxStyle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="#FFF4F4F7"/><Setter Property="Margin" Value="0,5"/>
        </Style>
    </Window.Resources>
    <Grid>
        <Border x:Name="Shell" Background="{StaticResource PanelBrush}" CornerRadius="0,0,23,23" BorderBrush="#20FFFFFF" BorderThickness="1,0,1,1" SnapsToDevicePixels="True" RenderTransformOrigin="0.5,0">
            <Border.RenderTransform><ScaleTransform x:Name="ShellScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
            <Border.Effect><DropShadowEffect Color="#000000" BlurRadius="30" ShadowDepth="9" Opacity="0.48"/></Border.Effect>
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid x:Name="RestView" Grid.RowSpan="3" Margin="12,4">
                    <StackPanel x:Name="RestEyes" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Ellipse x:Name="LeftEye" Width="7" Height="12" Fill="#FFF4F4FF" Margin="0,0,12,0"/>
                        <Ellipse x:Name="RightEye" Width="7" Height="12" Fill="#FFF4F4FF"/>
                    </StackPanel>
                    <StackPanel x:Name="RestMediaContent" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                        <Ellipse Width="11" Height="11" Stroke="#FF39D98A" StrokeThickness="2" Margin="0,0,13,0" ToolTip="Battery status"/>
                        <TextBlock x:Name="RestClock" Foreground="#FFF7F7F8" FontSize="17" FontWeight="Bold" VerticalAlignment="Center"/>
                        <StackPanel x:Name="RestWave" Orientation="Horizontal" Height="20" VerticalAlignment="Center" Margin="14,0,0,0">
                            <Border Width="3" Height="8" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="15" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="11" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="18" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                        </StackPanel>
                    </StackPanel>
                </Grid>
                <Grid x:Name="ExpandedView" Grid.RowSpan="3" Visibility="Collapsed" Margin="14,13,14,12">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Grid.Row="0" Margin="2,0,2,9">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeaderTitle" Foreground="#FFF7F7FA" FontWeight="SemiBold" FontSize="13" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock x:Name="BatteryGlyph" Text="◉" Foreground="{StaticResource GreenBrush}" FontSize="10" Margin="0,0,7,0"/>
                            <TextBlock x:Name="DateClock" Foreground="#FFF1F1F3" FontSize="12"/>
                        </StackPanel>
                        <StackPanel x:Name="HeaderWave" Grid.Column="2" Orientation="Horizontal" Height="18" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="12,0,2,0">
                            <Border Width="3" Height="7" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="13" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="10" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                            <Border Width="3" Height="16" Background="White" CornerRadius="2" Margin="1" RenderTransformOrigin="0.5,0.5"><Border.RenderTransform><ScaleTransform ScaleY="0.45"/></Border.RenderTransform></Border>
                        </StackPanel>
                    </Grid>
                    <ContentControl x:Name="PanelContent" Grid.Row="1"/>
                    <StackPanel x:Name="Navigation" Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0"/>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</Window>
